-- References & State Variables
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local localPlayer = Players.LocalPlayer
local modelId = 104515922403348
local heightOffset = 3
local idleAnimationId = 101907348895136
local runAnimationId = 100466662502744
local landingAnimationId = 91194170893496
local landingSoundId = 82613796053949
local impactSoundId = 74149238738530
local ambienceSoundIds = {105438678078526, 92139743699536, 82618476532926}
local landingCooldown = 10
local toolGripOffset = CFrame.new(0, -0.4, 0) * CFrame.Angles(math.rad(180), math.rad(0), math.rad(90))
local isThirdPerson = true

-- Custom Movement Settings
local customWalkSpeed = 45
local customJumpPower = 50

local activeMorphs = {} -- Tracks active morphs per player for script execution sharing
local localMorphActive = false
local currentAmbience = nil
local movementEnabled = false
local runTrack, idleTrack, landingTrack, lastMoveState = nil, nil, nil, nil
local lastLandingTime = 0

-- Connections & Objects
local enforceLoop, movementLoop, inputConnection = nil, nil, nil
local originalWalkSpeed, originalJumpPower, originalJumpHeight = 16, 50, 7.2

-- Helper Utilities
local function loadModel()
    local success, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. modelId)
    end)
    if success and result and #result > 0 then
        return result[1]
    end
    return nil
end

local function createAnimation(animationId)
    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://" .. animationId
    return animation
end

local function createSound(soundId)
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. soundId
    return sound
end

local function playSound(soundObject, parentPart)
    if not soundObject then return end
    soundObject.Parent = parentPart or workspace
    soundObject:Play()
end

-- Shared Cleanup Handler
local function cleanupMorphForPlayer(targetPlayer)
    local data = activeMorphs[targetPlayer]
    if not data then return end

    if targetPlayer == localPlayer then
        if inputConnection then inputConnection:Disconnect() inputConnection = nil end
        if enforceLoop then enforceLoop:Disconnect() enforceLoop = nil end
        if movementLoop then movementLoop:Disconnect() movementLoop = nil end
        if currentAmbience then currentAmbience:Stop() currentAmbience = nil end
        if landingTrack then landingTrack:Stop() landingTrack = nil end
        if runTrack then runTrack:Stop() runTrack = nil end
        if idleTrack then idleTrack:Stop() idleTrack = nil end

        local camera = workspace.CurrentCamera
        if camera then
            camera.CameraType = Enum.CameraType.Custom
        end

        local char = localPlayer.Character
        if char then
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            if hum then
                hum.WalkSpeed = originalWalkSpeed
                hum.JumpPower = originalJumpPower
                if originalJumpHeight then hum.JumpHeight = originalJumpHeight end
            end
        end
        localMorphActive = false
    end

    local char = targetPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 0
                part.CanCollide = true
            elseif part:IsA("Decal") or part:IsA("Texture") then
                part.Transparency = 0
            end
        end
    end

    if data.MorphModel then
        data.MorphModel:Destroy()
    end

    activeMorphs[targetPlayer] = nil
end

-- Build Morph on Target Player
local function applyMorphToPlayer(targetPlayer)
    if activeMorphs[targetPlayer] then
        cleanupMorphForPlayer(targetPlayer)
    end

    local char = targetPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local headPart = char:FindFirstChild("Head")
    if not rootPart or not hum then return end

    local morphModel = loadModel()
    if not morphModel then return end

    local morphHumanoid = morphModel:FindFirstChildWhichIsA("Humanoid")
    if morphHumanoid then morphHumanoid:Destroy() end

    for _, part in ipairs(morphModel:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.CanCollide = false
        end
    end

    local morphRootPart = morphModel:FindFirstChild("HumanoidRootPart", true) or morphModel:FindFirstChild("RootPart", true)
    if not morphRootPart then
        morphRootPart = Instance.new("Part")
        morphRootPart.Name = "HumanoidRootPart"
        morphRootPart.Size = Vector3.new(2, 1, 1)
        morphRootPart.Anchored = false
        morphRootPart.CanCollide = false
        morphRootPart.Parent = morphModel
    end
    morphModel.PrimaryPart = morphRootPart

    local morphHeadPart = morphModel:FindFirstChild("Head", true)
    if not morphHeadPart then
        morphHeadPart = Instance.new("Part")
        morphHeadPart.Name = "Head"
        morphHeadPart.Size = Vector3.new(1, 1, 1)
        morphHeadPart.Anchored = false
        morphHeadPart.CanCollide = false
        morphHeadPart.Parent = morphModel
    end

    -- Parent inside character so every local script listener anchors to the target player
    morphModel.Name = "HonchoMorphModel"
    morphModel.Parent = char

    -- Hide base player parts
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and not part:IsDescendantOf(morphModel) then
            part.Transparency = 1
            part.CanCollide = false
        elseif (part:IsA("Decal") or part:IsA("Texture")) and not part:IsDescendantOf(morphModel) then
            part.Transparency = 1
        end
    end

    -- Welds
    local rootWeld = Instance.new("Weld")
    rootWeld.Part0 = rootPart
    rootWeld.Part1 = morphRootPart
    rootWeld.C0 = CFrame.new(0, heightOffset, 0)
    rootWeld.Parent = rootPart

    local headWeld = Instance.new("Weld")
    headWeld.Part0 = headPart or rootPart
    headWeld.Part1 = morphHeadPart
    local headWeldOffset = morphHeadPart.Position - (headPart and headPart.Position or rootPart.Position)
    headWeld.C0 = CFrame.new(headWeldOffset)
    headWeld.Parent = headWeld.Part0

    activeMorphs[targetPlayer] = {
        MorphModel = morphModel,
        RootWeld = rootWeld,
        HeadWeld = headWeld,
        MorphHeadPart = morphHeadPart
    }

    -- Setup local-only camera, inputs & animations if applying to self
    if targetPlayer == localPlayer then
        localMorphActive = true

        StarterGui:SetCore("SendNotification", {
            Title = "Credits",
            Text = "Made by MorthenHubber. Credit if you use it",
            Duration = 5
        })

        originalWalkSpeed = hum.WalkSpeed
        originalJumpPower = hum.JumpPower
        originalJumpHeight = hum.JumpHeight

        hum.WalkSpeed = customWalkSpeed
        hum.JumpPower = customJumpPower

        local camera = workspace.CurrentCamera
        if camera then
            camera.CameraType = Enum.CameraType.Scriptable
        end

        enforceLoop = RunService.RenderStepped:Connect(function()
            if rootWeld and rootWeld.Parent then
                rootWeld.C0 = CFrame.new(0, heightOffset, 0)
            end

            if morphHeadPart and morphHeadPart:IsDescendantOf(workspace) and camera then
                local lookVector = camera.CFrame.LookVector
                local upVector = camera.CFrame.UpVector
                local headPos = morphHeadPart.Position
                
                if isThirdPerson then
                    local camPos = headPos - (lookVector * 12) + Vector3.new(0, 2, 0)
                    camera.CFrame = CFrame.lookAt(camPos, headPos, upVector)
                else
                    local offset = Vector3.new(0, 0.2, -0.5)
                    local targetPosition = morphHeadPart.CFrame:PointToWorldSpace(offset)
                    camera.CFrame = CFrame.lookAt(targetPosition, targetPosition + lookVector, upVector)
                end
            end

            local morphRightHand = morphModel:FindFirstChild("RightHand", true)
            if char and morphRightHand then
                for _, tool in ipairs(char:GetChildren()) do
                    if tool:IsA("Tool") then
                        local handle = tool:FindFirstChild("Handle")
                        if handle then
                            local defaultGrip = handle:FindFirstChild("RightGrip")
                            if defaultGrip then
                                if defaultGrip:IsA("Motor6D") then
                                    defaultGrip.Enabled = false
                                else
                                    defaultGrip:Destroy()
                                end
                            end
                            local defaultLeftGrip = handle:FindFirstChild("LeftGrip")
                            if defaultLeftGrip then
                                if defaultLeftGrip:IsA("Motor6D") then
                                    defaultLeftGrip.Enabled = false
                                else
                                    defaultLeftGrip:Destroy()
                                end
                            end

                            local morphWeld = handle:FindFirstChild("MorphWeld")
                            if not morphWeld then
                                morphWeld = Instance.new("Weld")
                                morphWeld.Name = "MorphWeld"
                                morphWeld.Part0 = morphRightHand
                                morphWeld.Part1 = handle
                                morphWeld.C0 = toolGripOffset
                                morphWeld.Parent = handle
                            elseif morphWeld.Part0 ~= morphRightHand then
                                morphWeld.Part0 = morphRightHand
                            end
                        end
                    end
                end
            end
        end)

        local animationController = morphModel:FindFirstChildWhichIsA("AnimationController") or morphModel:FindFirstChild("AnimationController", true)
        if not animationController then
            animationController = Instance.new("AnimationController", morphModel)
        end
        local animator = morphModel:FindFirstChildWhichIsA("Animator") or (animationController and animationController:FindFirstChildWhichIsA("Animator"))
        if not animator then
            animator = Instance.new("Animator", animationController)
        end

        local function playAnimation(animationObject, looped)
            local track = animator:LoadAnimation(animationObject)
            if track then
                track.Looped = looped or false
                track:Play()
            end
            return track
        end

        local idleAnimation = createAnimation(idleAnimationId)
        local runAnimation = createAnimation(runAnimationId)
        local landingAnimation = createAnimation(landingAnimationId)

        local landingSound = createSound(landingSoundId)
        local impactSound = createSound(impactSoundId)

        local ambienceSounds = {}
        for i, id in ipairs(ambienceSoundIds) do
            local sound = createSound(id)
            sound.Looped = true
            ambienceSounds[i] = sound
        end

        local footstepsSound = nil
        for _, child in ipairs(morphModel:GetDescendants()) do
            if child:IsA("Sound") and child.Name == "Footsteps" then
                footstepsSound = child
                break
            end
        end

        local function replayLanding()
            if tick() - lastLandingTime < landingCooldown then return end
            lastLandingTime = tick()

            if landingTrack then landingTrack:Stop() end
            landingTrack = playAnimation(landingAnimation, false)
            playSound(landingSound, morphModel)
            playSound(impactSound, morphModel)
            movementEnabled = false

            hum.WalkSpeed = 0
            hum.JumpPower = 0
            if hum.JumpHeight then hum.JumpHeight = 0 end

            if landingTrack then
                landingTrack.Stopped:Connect(function()
                    hum.WalkSpeed = customWalkSpeed
                    hum.JumpPower = customJumpPower
                    movementEnabled = true
                    if not runTrack or not runTrack.IsPlaying then
                        idleTrack = playAnimation(idleAnimation, true)
                    end
                end)
            else
                hum.WalkSpeed = customWalkSpeed
                hum.JumpPower = customJumpPower
                movementEnabled = true
            end
        end

        local keySoundMap = {}
        local ambienceKeys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.V}
        for i, key in ipairs(ambienceKeys) do
            if ambienceSounds[i] then keySoundMap[key] = ambienceSounds[i] end
        end

        inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                local key = input.KeyCode
                local sound = keySoundMap[key]
                if sound then
                    if currentAmbience == sound then
                        sound:Stop()
                        currentAmbience = nil
                    else
                        if currentAmbience then currentAmbience:Stop() end
                        playSound(sound, morphModel)
                        currentAmbience = sound
                    end
                    return
                end
                if key == Enum.KeyCode.B then
                    replayLanding()
                elseif key == Enum.KeyCode.L then
                    isThirdPerson = not isThirdPerson
                end
            end
        end)

        replayLanding()

        movementLoop = RunService.RenderStepped:Connect(function()
            if not movementEnabled then return end
            local moveDirection = hum.MoveDirection
            if not moveDirection then return end
            local moving = moveDirection.Magnitude > 0.1

            if moving then
                if lastMoveState ~= "run" then
                    if idleTrack then idleTrack:Stop() end
                    runTrack = playAnimation(runAnimation, true)
                    lastMoveState = "run"
                end
                if footstepsSound and not footstepsSound.IsPlaying then
                    footstepsSound:Play()
                end
            else
                if lastMoveState ~= "idle" then
                    if runTrack then runTrack:Stop() end
                    idleTrack = playAnimation(idleAnimation, true)
                    lastMoveState = "idle"
                end
                if footstepsSound and footstepsSound.IsPlaying then
                    footstepsSound:Stop()
                end
            end
        end)
    end
end

-- Synchronize with other players executing the script
local function syncPlayers()
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= localPlayer and otherPlayer.Character then
            if otherPlayer.Character:FindFirstChild("HonchoMorphModel") or otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                if not activeMorphs[otherPlayer] then
                    applyMorphToPlayer(otherPlayer)
                end
            end
        end
    end
end

-- Keybind Toggle: Alt + =
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local isAlt = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt)
        if isAlt and (input.KeyCode == Enum.KeyCode.Equals or input.KeyCode == Enum.KeyCode.KeypadEquals) then
            if localMorphActive then
                cleanupMorphForPlayer(localPlayer)
            else
                applyMorphToPlayer(localPlayer)
                syncPlayers()
            end
        end
    end
end)

-- Auto-sync when other players join or load characters
Players.PlayerAdded:Connect(function(otherPlayer)
    otherPlayer.CharacterAdded:Connect(function()
        task.wait(1)
        if localMorphActive then
            syncPlayers()
        end
    end)
end)

script.Destroying:Connect(function()
    cleanupMorphForPlayer(localPlayer)
end)
